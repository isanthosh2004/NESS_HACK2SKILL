# Copy to .env (git-ignored) for LOCAL runs only. Never commit .env.
# On Cloud Run these come from Secret Manager references instead.

# Gemini API key from https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=

# Optional overrides of config.yaml
# GOOGLE_CLOUD_PROJECT=your-project-id
# AGENTCONTROL_FIXER_MODEL=gemini-2.5-flash
# AGENTCONTROL_AUDITOR_MODEL=gemini-2.5-pro
# AGENTCONTROL_DEMO_REPO=your-github-user/loanlab

# Needed from Task 7 onward (GitHub PRs). Locally only; prod reads Secret Manager.
# GITHUB_TOKEN=
